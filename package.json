{
	"name": "growclip-marketing-site",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "env -u NO_COLOR npx playwright test --config=playwright.config.cjs",
		"test:e2e:ui": "env -u NO_COLOR npx playwright test --config=playwright.config.cjs --ui",
		"test:e2e:a11y": "env -u NO_COLOR npx playwright test --config=playwright.config.cjs a11y.spec.ts",
		"test:e2e:a11y:strict": "A11Y_STRICT=1 env -u NO_COLOR npx playwright test --config=playwright.config.cjs a11y.spec.ts",
		"test:e2e:visual": "env -u NO_COLOR npx playwright test --config=playwright.config.cjs visual.spec.ts",
		"diagnose": "npm run check && npm run lint && npm run test && npm run test:e2e && npm run build"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@eslint/js": "^9.33.0",
		"@iconify-json/tabler": "^1.2.19",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.22.3",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@tailwindcss/vite": "^4.1.11",
		"@types/node": "^25.6.0",
		"@typescript-eslint/eslint-plugin": "^8.44.1",
		"@typescript-eslint/parser": "^8.44.1",
		"axe-core": "^4.12.1",
		"daisyui": "^5.0.46",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.35.5",
		"svelte-check": "^4.2.2",
		"svelte-eslint-parser": "^1.3.3",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.8.3",
		"unplugin-icons": "^22.1.0",
		"vite": "^5.4.19",
		"vitest": "^2.1.5"
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"trailingComma": "none",
		"printWidth": 100,
		"plugins": [
			"prettier-plugin-svelte"
		],
		"overrides": [
			{
				"files": "*.svelte",
				"options": {
					"parser": "svelte"
				}
			}
		]
	}
}
